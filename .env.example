# src/app/core/config.py 의 Settings 와 1:1 로 대응한다.
# 필드를 추가하면 여기도 추가해야 한다 — tests/unit/test_env_example_sync.py 가 검사한다.

ENVIRONMENT=local
APP_NAME=my-fastapi
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DEFAULT_LOCALE=ko

# --- database: SQLite (엔진은 lifespan 이 만든다, §2.1)
# 방언 교체는 이 한 줄이다 (§1.6). 지원 드라이버 목록은 core/config.py 에 있고,
# 목록에 없는 URL 은 기동 시점에 거부된다:
#   postgresql+psycopg://app:app@localhost:5432/app
#   mysql+asyncmy://app:app@localhost:3306/app
DATABASE_URL=sqlite+aiosqlite:///./var/app.db
DB_ECHO=false
# SQLite 는 외래키가 기본 OFF 다. 끄면 §4 의 FK 가 전부 장식이 된다.
DB_FOREIGN_KEYS=true
# WAL / DELETE / MEMORY. 운영은 WAL.
DB_JOURNAL_MODE=WAL
# 쓰기 잠금 대기(ms). SQLite 는 쓰기가 한 번에 하나다.
DB_BUSY_TIMEOUT_MS=5000

# --- 서버 DB 전용 (SQLite 에서는 무시된다 — 파일이라 커넥션 풀이 의미가 없다)
# PostgreSQL/MySQL 로 옮기면 그때부터 의미가 생긴다 (§1.6).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 유휴 중에 끊긴 연결을 미리 걸러낸다.
DB_POOL_PRE_PING=true
# MySQL 의 wait_timeout(기본 8시간)보다 짧아야 한다.
DB_POOL_RECYCLE_SECONDS=3600

# --- redis
REDIS_URL=redis://localhost:6379/0

# --- security (§2.2: 토큰 encode/decode 만)
# 운영에서 기본값을 그대로 두면 기동이 거부된다.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=my-fastapi
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- 첨부파일 (§4.9). 저장소 인스턴스는 lifespan 이 만든다
STORAGE_ROOT=./var/uploads
# 10MB. 저장하면서 재고 넘으면 그 자리에서 끊는다.
ATTACHMENT_MAX_BYTES=10485760
# 확장자 허용 목록. JSON 배열로 넣는다.
ATTACHMENT_ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp","pdf","txt","csv","zip","docx","xlsx","pptx"]

# --- 백그라운드 작업 (§4.4, §4.5, §4.9). 0 이면 그 작업을 돌리지 않는다
# 조회수 버퍼 반영 주기(초). 짧을수록 최신이고 쓰기가 잦다.
VIEW_FLUSH_INTERVAL_SECONDS=30
# comment_count 드리프트 보정 주기(초). 하루.
COMMENT_COUNT_RECONCILE_INTERVAL_SECONDS=86400
# 고아 첨부 정리 주기(초).
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=3600
# 이 시간이 지나도 글에 붙지 않은 첨부는 고아로 본다(초).
ATTACHMENT_ORPHAN_TTL_SECONDS=86400

# --- CORS (§0: 하드코딩 금지. JSON 배열로 넣는다)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# --- 외부 서버 (§5). 이름 → 설정. n개로 늘어나도 코드 변경은 없다.
# base_url 만 필수. 나머지는 core/upstream.py 의 기본값을 쓴다.
# health_path 를 주면 /health/ready 가 그 경로를 찔러본다.
UPSTREAMS={"a":{"base_url":"https://a.example.com","health_path":"/healthz"},"b":{"base_url":"https://b.example.com","read_timeout_seconds":10}}
# 개별 키만 덮어쓰려면:
#   UPSTREAMS__A__READ_TIMEOUT_SECONDS=10
#   UPSTREAMS__A__API_KEY=Bearer xxx
