# src/app/core/config.py 의 Settings 와 1:1 로 대응한다.
# 필드를 추가하면 여기도 추가해야 한다 — tests/unit/test_env_example_sync.py 가 검사한다.

ENVIRONMENT=local
APP_NAME=my-fastapi
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- database (엔진은 lifespan 이 만든다, §2.1)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- redis
REDIS_URL=redis://localhost:6379/0

# --- CORS (§0: 하드코딩 금지. JSON 배열로 넣는다)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
